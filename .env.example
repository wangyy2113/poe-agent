# POE1-Agent 密钥与环境配置
# 复制为 .env 后填入实际值：
#   macOS/Linux  cp .env.example .env
#   Windows      copy .env.example .env
#
# 只放密钥与环境相关项；声明式行为配置在 config.yaml。

# ── 必填：LLM（OpenAI 兼容，直连内部 LiteLLM 网关）──
LLM_BASE_URL=https://your-llm-gateway.example.com
LLM_API_KEY=sk-
LLM_MODEL=glm-5.2

# 多 Key 故障转移（可选，配了就优先于 LLM_API_KEY）
# 格式：key[:model]，逗号分隔，**按优先级从高到低**排列。
# 省略 :model 的条目沿用上面的 LLM_MODEL。
# 行为：始终用第一个健康的 Key；额度耗尽冷却 30 分钟，鉴权/模型权限失败冷却 60 分钟；
#      5xx / 429 等瞬时错误只重试不降级 Key。切 Key 时同步切到该 Key 绑定的模型
#      （受限 Key 访问别的模型只会返回 401）。
# LLM_API_KEYS=sk-aaa,sk-bbb:claude-sonnet-4-6

# ── 可选：Embedding / ReRank ──
# 2026-10-30 实测：网关暴露了 /v1/embeddings 与 /v1/rerank 端点，
# 但未注册任何 embedding / rerank 模型，故两个可选通道默认关闭（见 config.yaml）。
# 只有模型确实能从 /v1/embeddings 返回固定维度向量，才能用它建索引。
# 向量通道必须完整回填当前模型的全部知识切片才能打开。
# EMBEDDING_BASE_URL=https://your-llm-gateway.example.com
# EMBEDDING_API_KEY=sk-
# EMBEDDING_MODEL=
# RERANK_BASE_URL=https://your-rerank-gateway.example.com
# RERANK_API_KEY=sk-
# RERANK_MODEL=

# ── 必填：管理凭证 ──
# /index 与 /admin 可触发外部抓取与索引重建，属高开销可滥用操作，
# 必须使用独立管理令牌，不与普通用户 API Key 共用。
ADMIN_TOKEN=

# ── 可选：普通用户 API Key（逗号分隔）──
# 留空表示不校验（仅限本机开发；对外提供服务时必须配置）
# API_KEYS=

# ── 可选：GGG 官方角色 API ──
# 从 https://www.pathofexile.com/developer/docs/authorization 获取；token 必须包含
# account:characters scope。只保存在服务端，不会下发给浏览器或写入日志。
# POE_OAUTH_TOKEN=
# GGG 强制要求：OAuth {$clientId}/{$version} (contact: {$contact})
# POE_OAUTH_USER_AGENT=OAuth your-client-id/0.1.0 (contact: you@example.com)
